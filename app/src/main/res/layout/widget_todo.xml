<?xml version="1.0" encoding="utf-8"?>
<!-- v5.0 待办清单 (4x3): the confirmed 待办; one tap checks one off. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/todo_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/todo_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待办"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/todo_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_circle_accent"
            android:gravity="center"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:text="0"
            android:textColor="@color/widget_accent_text"
            android:textSize="12sp"
            android:textStyle="bold" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <ImageButton
            android:id="@+id/todo_record"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_orb"
            android:contentDescription="开始录音"
            android:src="@drawable/ic_w_mic_on_orb" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/todo_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp" />
        <LinearLayout
            android:id="@+id/todo_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/todo_empty_spirit"
                android:layout_width="64dp"
                android:layout_height="62dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_spirit_happy" />
            <TextView
                android:id="@+id/todo_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="待办都处理好了"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/todo_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_bg_raised"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="查看全部"
        android:textColor="@color/widget_accent_text"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
