<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="quick_record"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_record"
        android:shortcutShortLabel="@string/shortcut_record_short"
        android:shortcutLongLabel="@string/shortcut_record_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.example.shuolesa"
            android:targetClass="com.example.shuolesa.MainActivity">
            <extra
                android:name="auto_start_recording"
                android:value="true" />
        </intent>
    </shortcut>
</shortcuts>
