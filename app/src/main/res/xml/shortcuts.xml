<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- v4.1: launcher shortcut opens screen ④ 今日 on the exported MainActivity. Navigation only:
         it never records (MainActivity ignores extras without the in-process token; see a.3). -->
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_today"
        android:shortcutShortLabel="@string/shortcut_today_short"
        android:shortcutLongLabel="@string/shortcut_today_long">
        <intent
            android:action="com.example.shuolesa.action.OPEN_TODAY"
            android:targetPackage="com.example.shuolesa"
            android:targetClass="com.example.shuolesa.MainActivity" />
    </shortcut>
</shortcuts>
